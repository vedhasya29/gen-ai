<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vedhasya G — Profile</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');

  :root{
    --bg-deep: #050a12;
    --bg-panel: #0b1420;
    --line: #16263a;
    --cyan: #4fd8e6;
    --violet: #8b7bff;
    --text-main: #e8f1f7;
    --text-dim: #7f93a8;
  }

  *{ margin:0; padding:0; box-sizing:border-box; }

  html{ scroll-behavior:smooth; }

  body{
    background:
      radial-gradient(circle at 15% 8%, rgba(79,216,230,0.08), transparent 40%),
      radial-gradient(circle at 85% 92%, rgba(139,123,255,0.10), transparent 45%),
      var(--bg-deep);
    color: var(--text-main);
    font-family: 'Space Grotesk', sans-serif;
    line-height: 1.6;
    overflow-x: hidden;
  }

  body::before{
    content:'';
    position:fixed; inset:0;
    background-image:
      linear-gradient(rgba(79,216,230,0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(79,216,230,0.045) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 20%, black 40%, transparent 90%);
    pointer-events:none;
    z-index:0;
  }

  .wrap{ position:relative; z-index:1; max-width: 880px; margin:0 auto; padding: 72px 28px 100px; }

  .hero{
    display:flex; flex-direction:column; gap:18px;
    padding-bottom: 46px; border-bottom: 1px solid var(--line);
    opacity:0; transform: translateY(14px);
    animation: rise 0.8s ease forwards;
  }

  .id-tag{
    font-family:'JetBrains Mono', monospace;
    font-size: 12.5px; letter-spacing: 0.14em;
    color: var(--cyan);
    display:flex; align-items:center; gap:10px;
  }
  .id-tag .dot{
    width:7px; height:7px; border-radius:50%;
    background: var(--cyan);
    box-shadow: 0 0 10px 2px rgba(79,216,230,0.7);
    animation: pulse 2.2s ease-in-out infinite;
  }

  .name-line{
    font-size: clamp(40px, 7vw, 64px);
    font-weight: 700;
    letter-spacing: -0.01em;
    display:flex; flex-wrap:wrap; align-items:baseline; gap: 14px;
  }
  .name-line .glow{
    background: linear-gradient(100deg, var(--cyan), var(--violet) 70%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .cursor{
    display:inline-block; width: 3px; height: 0.85em;
    background: var(--cyan);
    animation: blink 1s steps(1) infinite;
    transform: translateY(3px);
  }

  .role{
    font-family:'JetBrains Mono', monospace;
    font-size: 15px; color: var(--text-dim);
  }
  .role strong{ color: var(--text-main); font-weight:600; }

  .contact-row{
    display:flex; flex-wrap:wrap; gap: 14px; margin-top: 8px;
  }
  .contact-pill{
    font-family:'JetBrains Mono', monospace;
    font-size: 13px;
    padding: 9px 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255,255,255,0.015);
    color: var(--text-main);
    display:flex; align-items:center; gap:9px;
    transition: border-color .25s ease, transform .25s ease, box-shadow .25s ease;
  }
  .contact-pill:hover{
    border-color: rgba(79,216,230,0.5);
    box-shadow: 0 0 18px -6px rgba(79,216,230,0.5);
    transform: translateY(-2px);
  }
  .contact-pill .k{ color: var(--cyan); }

  section{ padding: 46px 0; border-bottom: 1px solid var(--line); }
  section:last-child{ border-bottom:none; }

  .sec-head{
    display:flex; align-items:center; gap: 14px;
    margin-bottom: 22px;
  }
  .sec-num{
    font-family:'JetBrains Mono', monospace;
    font-size: 12px; color: var(--text-dim);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 4px 8px;
  }
  .sec-title{ font-size: 22px; font-weight: 600; }
  .sec-title .accent{ color: var(--cyan); }

  p.body-text{ color: var(--text-dim); max-width: 66ch; }
  p.body-text strong{ color: var(--text-main); font-weight:600; }

  .stack{ display:flex; flex-direction:column; gap: 16px; }
  .card{
    position:relative;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 22px 24px;
    background: linear-gradient(180deg, rgba(255,255,255,0.02), transparent);
    overflow:hidden;
  }
  .card::before{
    content:'';
    position:absolute; left:0; top:0; bottom:0; width:2px;
    background: linear-gradient(180deg, var(--cyan), var(--violet));
    opacity:0.8;
  }
  .card-top{
    display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:8px;
    margin-bottom: 6px;
  }
  .card-title{ font-weight:600; font-size:17px; }
  .card-meta{
    font-family:'JetBrains Mono', monospace;
    font-size: 12.5px; color: var(--cyan);
    border: 1px solid rgba(79,216,230,0.3);
    padding: 3px 9px; border-radius: 20px;
  }
  .card-sub{ color: var(--text-dim); font-size: 14px; }
